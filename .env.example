# --- Browser-visible (prefixed VITE_) ---
# Google sign-in: OAuth *Web* client ID (also used by the Android native login)
VITE_GOOGLE_CLIENT_ID=
# Only needed for the Android APK (it has no server of its own): your deployed site
VITE_API_URL=

# --- Server-side only (.env for `npm run dev`, Vercel env vars when deployed) ---
AUTH_SECRET=change-me-to-a-long-random-string
# Email codes via Gmail (recommended):
SMTP_USER=
SMTP_PASS=
# ...or via Resend:
RESEND_API_KEY=
MAIL_FROM=
# Phone verification codes via Twilio Verify:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Gemini: translation into any language + AI answers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Cloud Indian English, Hindi, and supported regional-language voices
GOOGLE_TTS_API_KEY=
