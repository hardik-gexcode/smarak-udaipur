# --- Browser-visible (prefixed VITE_) ---
# Google sign-in: OAuth *Web* client ID (Get from Google Cloud Console > APIs & Services > Credentials > OAuth client ID)
VITE_GOOGLE_CLIENT_ID=
# Only needed for Android APK (points to your deployed Vercel/web URL):
VITE_API_URL=

# --- Server-side only (.env for `npm run dev`, Vercel Environment Variables when deployed) ---
AUTH_SECRET=change-me-to-a-long-random-string
# Email codes via Gmail SMTP:
# (SMTP_USER = your gmail, SMTP_PASS = 16-char App Password from myaccount.google.com/apppasswords)
SMTP_USER=
SMTP_PASS=
# ...or via Resend (https://resend.com):
RESEND_API_KEY=
MAIL_FROM=
# Phone verification codes via Twilio Verify (https://console.twilio.com):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional Gemini-backed Ask Guide (regional text translation does not use this key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Server-side only: live speech-to-speech guide via OpenAI Realtime. Never prefix with VITE_.
OPENAI_API_KEY=
# Cloud Indian English, Hindi, and supported regional voices (Google Cloud Text-to-Speech API):
GOOGLE_TTS_API_KEY=
