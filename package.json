{
  "name": "smarak-udaipur",
  "version": "1.0.0",
  "private": true,
  "description": "SMARAK Udaipur - offline-first, bilingual AR heritage companion (Domain 1: Heritage, Tourism & Sustainable Hospitality)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:https": "HTTPS=1 vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "android:add": "cap add android && node scripts/patch-android.mjs",
    "android:prep": "node scripts/patch-android.mjs",
    "android:sync": "npm run build && cap sync android && node scripts/patch-android.mjs",
    "android:open": "cap open android",
    "apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "assets": "npx @capacitor/assets generate --android --iconBackgroundColor '#fdf6e6' --splashBackgroundColor '#fdf6e6'"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.9",
    "@capgo/capacitor-social-login": "^7.20.0",
    "nodemailer": "^6.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/cli": "^7.4.0",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0"
  }
}
